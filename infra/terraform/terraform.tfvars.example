# terraform.tfvars.example - concrete sample values for a Singapore-resident deploy.
#
# Copy to terraform.tfvars and fill in your own ids. Do NOT commit terraform.tfvars.
# Region / zone already default to Singapore. All ids below are obviously fictional.

project_id = "acme-campaign-planner-sg-prod"

# Residency. `region` is chosen at deploy time and must be a member of `allowed_regions`;
# both default to Singapore, so these lines just restate the secure default. To deploy
# elsewhere, set BOTH: extending `allowed_regions` is the deliberate residency review point
# and belongs only after confirming the managed stack and your obligations in that region.
allowed_regions = ["asia-southeast1"]
region          = "asia-southeast1"
zone            = "asia-southeast1-a"

# ~7-year WORM retention for the audit log. Bucket lock is irreversible.
retention_days = 2557

# The WORM lock has NO default: a plan refuses until it is stated here. true is the compliant
# production form and is IRREVERSIBLE for the retention window; an evaluation stack that must
# stay destroyable states false (NOT compliant).
worm_locked = true

# Container image built from the repo Dockerfile and pushed to Artifact Registry (SG).
image = "asia-southeast1-docker.pkg.dev/acme-campaign-planner-sg-prod/mkt/campaign-planner:0.1.0"

# Org / Access Context Manager. access_policy_id is the numeric policy id.
org_id           = "123456789012"
access_policy_id = "987654321098"

# Sovereignty perimeter on by default, dry-run first (enforce only after a clean dry-run).
enable_vpc_sc  = true
vpc_sc_dry_run = true

# Cheap runtime controls stay on in the reference; say so rather than inheriting the default.
# With review routing on the service refuses to boot without the console it routes plans to.
guardrail_enabled      = true
review_routing_enabled = true
human_review_url       = "https://human-review.acme-bank.example"
